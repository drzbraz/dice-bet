{
  "info": {
    "name": "Dice Bet API",
    "description": "REST mirror of the dice game's WebSocket use cases (Wallet, Play, EndPlay) plus /health. See the README for how to test the WebSocket endpoint directly in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d1ce6a00-0000-4000-8000-000000000001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "clientId", "value": "alice" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a fresh UUID v4 idempotency key for every request in this collection.",
          "function uuidv4() {",
          "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {",
          "    const r = (Math.random() * 16) | 0;",
          "    const v = c === 'x' ? r : (r & 0x3) | 0x8;",
          "    return v.toString(16);",
          "  });",
          "}",
          "pm.collectionVariables.set('idempotencyKey', uuidv4());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "0. Clients - List All",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has data.clients as a non-empty array', () => {",
                  "    pm.expect(body.data.clients).to.be.an('array');",
                  "    pm.expect(body.data.clients.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('clientId collection variable is one of the listed clients', () => {",
                  "    pm.expect(body.data.clients).to.include(pm.collectionVariables.get('clientId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Wallet - Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/{{clientId}}/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "{{clientId}}", "wallet"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has data.balance', () => pm.expect(body.data.balance).to.be.a('number'));",
                  "pm.collectionVariables.set('balanceBeforePlay', body.data.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Play - Bet EVEN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"betAmount\": 500,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/plays",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "plays"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('play is OPEN', () => pm.expect(body.data.status).to.eql('OPEN'));",
                  "pm.test('result is WIN or LOSE', () => pm.expect(['WIN', 'LOSE']).to.include(body.data.result));",
                  "pm.test('balance was debited by betAmount', () => {",
                  "  const before = pm.collectionVariables.get('balanceBeforePlay');",
                  "  pm.expect(body.data.balance).to.eql(before - 500);",
                  "});",
                  "pm.test('payout math: WIN pays 2x bet, LOSE pays 0', () => {",
                  "  const expected = body.data.result === 'WIN' ? 1000 : 0;",
                  "  pm.expect(body.data.payout).to.eql(expected);",
                  "});",
                  "pm.collectionVariables.set('lastResult', body.data.result);",
                  "pm.collectionVariables.set('lastPayout', body.data.payout);",
                  "pm.collectionVariables.set('balanceAfterPlay', body.data.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. EndPlay - Settle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/plays/end",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "plays", "end"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('play is CLOSED', () => pm.expect(body.data.status).to.eql('CLOSED'));",
                  "pm.test('creditedAmount matches the play\\'s payout', () => {",
                  "  pm.expect(body.data.creditedAmount).to.eql(pm.collectionVariables.get('lastPayout'));",
                  "});",
                  "pm.test('balance reflects the credited amount', () => {",
                  "  const before = pm.collectionVariables.get('balanceAfterPlay');",
                  "  pm.expect(body.data.balance).to.eql(before + body.data.creditedAmount);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Wallet - Get Balance (after)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/{{clientId}}/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "{{clientId}}", "wallet"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('final balance has no pending play left in flight', () => {",
                  "  pm.expect(body.data.balance).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Protections",
      "item": [
        {
          "name": "Bet Above Balance -> INSUFFICIENT_BALANCE",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"dave\",\n  \"betAmount\": 100,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] },
            "description": "Seeded client 'dave' starts with a 0 balance, so any positive bet exceeds it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code is INSUFFICIENT_BALANCE', () => pm.expect(pm.response.json().error.code).to.eql('INSUFFICIENT_BALANCE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Zero Bet -> INVALID_BET_AMOUNT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"betAmount\": 0,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code is INVALID_BET_AMOUNT', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_BET_AMOUNT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative Bet -> INVALID_BET_AMOUNT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"betAmount\": -100,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code is INVALID_BET_AMOUNT', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_BET_AMOUNT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Bet Type -> INVALID_BET_TYPE",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"betAmount\": 100,\n  \"betType\": \"PRIME\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code is INVALID_BET_TYPE', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_BET_TYPE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Play While Another Is Open (1/2) - Opens the play",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"carol\",\n  \"betAmount\": 100,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] },
            "description": "Opens a play for 'carol' so the next request can deterministically demonstrate the protection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('play is OPEN', () => pm.expect(pm.response.json().data.status).to.eql('OPEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Play While Another Is Open (2/2) -> PLAY_ALREADY_IN_PROGRESS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"carol\",\n  \"betAmount\": 100,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] },
            "description": "Run immediately after the previous request (uses a different Idempotency-Key, generated automatically): 'carol' still has an OPEN play, so this is rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code is PLAY_ALREADY_IN_PROGRESS', () => pm.expect(pm.response.json().error.code).to.eql('PLAY_ALREADY_IN_PROGRESS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup - EndPlay for carol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"carol\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays/end", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays", "end"] },
            "description": "Settles carol's play opened above, so re-running this folder from the top stays deterministic."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('play is CLOSED', () => pm.expect(pm.response.json().data.status).to.eql('CLOSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "End Play With No Open Play -> NO_ACTIVE_PLAY",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"bob\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays/end", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays", "end"] },
            "description": "Assumes 'bob' has no OPEN play at the time this runs (true on a freshly seeded database)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code is NO_ACTIVE_PLAY', () => pm.expect(pm.response.json().error.code).to.eql('NO_ACTIVE_PLAY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown Client -> CLIENT_NOT_FOUND",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/does-not-exist/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "does-not-exist", "wallet"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code is CLIENT_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('CLIENT_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replayed Idempotency Key -> Same Response",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "replay-demo-fixed-key" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"betAmount\": 100,\n  \"betType\": \"EVEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/plays", "host": ["{{baseUrl}}"], "path": ["api", "v1", "plays"] },
            "description": "Uses a fixed Idempotency-Key (not the auto-generated collection variable). Run this request twice: the second run must return byte-for-byte the same `data` as the first, without debiting the wallet again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const previous = pm.collectionVariables.get('replayDemoData');",
                  "if (previous) {",
                  "  pm.test('replayed response data is identical to the first response', () => {",
                  "    pm.expect(JSON.stringify(body.data)).to.eql(previous);",
                  "  });",
                  "}",
                  "pm.collectionVariables.set('replayDemoData', JSON.stringify(body.data));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Provably Fair",
      "item": [
        {
          "name": "1. Get Seed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/{{clientId}}/fairness/seed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "{{clientId}}", "fairness", "seed"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (or 404 FAIRNESS_DISABLED if the feature is off)', () => {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('has serverSeedHash and clientSeed', () => {",
                  "        pm.expect(body.data.serverSeedHash).to.be.a('string').with.length(64);",
                  "        pm.expect(body.data.clientSeed).to.be.a('string');",
                  "    });",
                  "    pm.collectionVariables.set('fairnessCommitment', body.data.serverSeedHash);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Rotate Seed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/{{clientId}}/fairness/rotate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "{{clientId}}", "fairness", "rotate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    const publishedHash = pm.collectionVariables.get('fairnessCommitment');",
                  "    pm.test('the revealed seed matches the commitment published by step 1', () => {",
                  "        pm.expect(body.data.retired.serverSeedHash).to.eql(publishedHash);",
                  "        pm.expect(body.data.retired.serverSeed).to.be.a('string').with.length(64);",
                  "    });",
                  "    pm.test('the new epoch has a different commitment', () => {",
                  "        pm.expect(body.data.active.serverSeedHash).to.not.eql(body.data.retired.serverSeedHash);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/{{clientId}}/fairness/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "{{clientId}}", "fairness", "history"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('includes the seed just retired in step 2', () => {",
                  "        pm.expect(body.data.seeds).to.be.an('array').with.lengthOf.at.least(1);",
                  "        pm.expect(body.data.seeds[0].serverSeed).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status field is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
