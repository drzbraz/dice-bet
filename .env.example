# Copy to .env and adjust as needed for local development (`make run`
# loads this via docker-compose / your shell; see README).

PORT=8080
DATABASE_URL=postgres://dicebet:dicebet@localhost:5432/dicebet?sslmode=disable
DB_MAX_CONNS=10
RUN_MIGRATIONS=true

MIN_BET=100
MAX_BET=1000000

READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
WS_PING_INTERVAL=30s
WS_MAX_MESSAGE_BYTES=4096

# How long a cached wallet balance is trusted without a fresh write-through
# (defense-in-depth backstop; every mutation writes through on commit).
WALLET_CACHE_TTL=30s

# Switches Play's roll derivation from plain crypto/rand to a deterministic
# commit-reveal scheme (seed.get/seed.rotate/seed.history endpoints, and a
# "fairness" block on every play.start response). Fully additive: false is
# byte-for-byte the pre-existing behavior. See README "Provably fair rolls".
PROVABLY_FAIR_ENABLED=false
